{
  "name": "modelpick",
  "version": "0.2.2",
  "description": "Pick the right model at every step of an AI agent workflow \u2014 with cost per solved task, not guesswork.",
  "type": "module",
  "bin": {
    "modelpick": "./bin/modelpick.js"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./catalog": "./catalog/models.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "catalog",
    "skills",
    "plugins",
    "types",
    "docs/*.md",
    "research/*.md",
    "research/hf-evidence.json",
    "tests/*.md",
    "tests/results/*.md",
    "tests/results/*.json",
    "bench",
    "assets/*.png",
    "assets/*.srt",
    "assets/*.ass",
    "assets/chart-data.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "server.json"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --test \"tests/integration/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.test.js\"",
    "bench": "node bench/run.js",
    "bench:holdout": "node bench/holdout.js",
    "bench:value": "node bench/value.js",
    "bench:sensitivity": "node bench/sensitivity.js",
    "scorecard": "node bench/scorecard.js",
    "applicability": "node scripts/applicability.js",
    "coverage": "node --test --experimental-test-coverage \"tests/**/*.test.js\"",
    "adversarial": "node tests/adversarial/run.js",
    "hf:evidence": "node scripts/collect-hf-evidence.js",
    "validate": "node scripts/validate.js",
    "check": "node scripts/check.js",
    "assets": "python scripts/make_assets.py",
    "prepare": "node scripts/validate.js",
    "smoke:live": "node scripts/live_smoke.js",
    "test:form": "node scripts/test_form.js"
  },
  "keywords": [
    "ai",
    "llm",
    "model-routing",
    "model-selection",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "deepseek-harness",
    "agents",
    "cost-optimization",
    "image-generation",
    "video-generation",
    "3d-generation"
  ],
  "author": "Leizhidong-creator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leizhidong-creator/modelpick.git"
  },
  "bugs": {
    "url": "https://github.com/Leizhidong-creator/modelpick/issues"
  },
  "homepage": "https://github.com/Leizhidong-creator/modelpick#readme",
  "funding": [],
  "mcpName": "io.github.Leizhidong-creator/modelpick"
}
