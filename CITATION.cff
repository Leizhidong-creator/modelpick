    given-names: "Zhidong"
version: "0.2.1"
date-released: "2026-11-19"
license: MIT
repository-code: "https://github.com/Leizhidong-creator/modelpick"
url: "https://leizhidong-creator.github.io/modelpick/"
keywords:
  - model routing
  - coding agents
  - MCP
  - cost per solved task
  - LLM benchmark
